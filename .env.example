# Copy to .env.local and fill in. Never commit .env.local.
# Supabase -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google Cloud -> APIs & Services -> Credentials (OAuth 2.0 Client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=XXXX.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YYYY.apps.googleusercontent.com

# Filled after `npx eas-cli@latest init`
EAS_PROJECT_ID=
